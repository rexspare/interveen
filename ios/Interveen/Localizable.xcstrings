      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search adult sites to attach them to Screen Time. Do not pick Safari or Chrome as blocked apps — that locks the whole browser."
          }
        }
      }
    },
