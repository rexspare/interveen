    },
    "%lld / 3" : {

    },
    "accessibility_service_description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراقب إنترفين شريط العنوان في متصفحات هذا الجهاز. عند فتح وجهة محظورة تُغلق الجلسة ويظهر تذكير هدفك. لا يغادر النص الهاتف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन इस फ़ोन के ब्राउज़र की एड्रेस बार देखता है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और आपका लक्ष्य सामने आता है। टेक्स्ट फ़ोन से बाहर नहीं जाता।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen obserwuje pasek adresu przeglądarek na tym urządzeniu. Gdy otworzy się zablokowany adres, sesja się zamyka i pojawia się przypomnienie celu. Tekst nie opuszcza telefonu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen bevakar adressfältet i webbläsarna på den här enheten. Öppnas ett blockerat mål stängs sessionen och din påminnelse visas. Texten lämnar inte telefonen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen beobachtet die Adressleiste der Browser auf diesem Gerät. Öffnet sich ein gesperrtes Ziel, wird die Sitzung geschlossen und Ihre Erinnerung gezeigt. Text verlässt das Telefon nicht."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen watches the address bar of your browsers on this device. When a blocked destination is opened, the browsing session is closed and your personal goal reminder is shown. Text never leaves the phone."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen watches the address bar of your browsers on this device. When a blocked destination is opened, the browsing session is closed and your personal goal reminder is shown. Text never leaves the phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen observa la barra de direcciones de los navegadores de este dispositivo. Si se abre un destino bloqueado, se cierra la sesión y aparece tu recordatorio. El texto no sale del teléfono."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يراقب إنترفين شريط العنوان في متصفحات هذا الجهاز. عند فتح وجهة محظورة تُغلق الجلسة ويظهر تذكير هدفك. لا يغادر النص الهاتف."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen bevakar adressfältet i webbläsarna på den här enheten. Öppnas ett blockerat mål stängs sessionen och din påminnelse visas. Texten lämnar inte telefonen."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen memantau bilah alamat peramban di perangkat ini. Jika tujuan yang diblokir terbuka, sesi ditutup dan pengingat tujuan Anda muncul. Teks tidak meninggalkan ponsel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen surveille la barre d’adresse des navigateurs de cet appareil. Si une destination bloquée s’ouvre, la session se ferme et votre rappel apparaît. Le texte ne quitte pas le téléphone."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन इस फ़ोन के ब्राउज़र की एड्रेस बार देखता है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और आपका लक्ष्य सामने आता है। टेक्स्ट फ़ोन से बाहर नहीं जाता।"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen עוקב אחר שורת הכתובת בדפדפנים במכשיר הזה. כשנפתח יעד חסום, הסשן נסגר ומופיעה תזכורת המטרה. הטקסט לא עוזב את הטלפון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन इस फ़ोन के ब्राउज़र की एड्रेस बार देखता है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और आपका लक्ष्य सामने आता है। टेक्स्ट फ़ोन से बाहर नहीं जाता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen obserwuje pasek adresu przeglądarek na tym urządzeniu. Gdy otworzy się zablokowany adres, sesja się zamyka i pojawia się przypomnienie celu. Tekst nie opuszcza telefonu."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen memantau bilah alamat peramban di perangkat ini. Jika tujuan yang diblokir terbuka, sesi ditutup dan pengingat tujuan Anda muncul. Teks tidak meninggalkan ponsel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen osserva la barra degli indirizzi dei browser su questo dispositivo. Se si apre una destinazione bloccata, la sessione si chiude e compare il promemoria. Il testo non lascia il telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen はこの端末のブラウザのアドレスバーを見守ります。ブロックした行き先が開くとセッションを閉じ、目標のリマインダーを表示します。文字は端末の外に出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen은 이 기기의 브라우저 주소 표시줄을 봅니다. 차단된 목적지가 열리면 세션을 닫고 목표 알림을 보여 줍니다. 텍스트는 휴대폰을 떠나지 않습니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन इस फ़ोन के ब्राउज़र की एड्रेस बार देखता है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और आपका लक्ष्य सामने आता है। टेक्स्ट फ़ोन से बाहर नहीं जाता।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen memantau bilah alamat peramban di perangkat ini. Jika tujuan yang diblokir terbuka, sesi ditutup dan pengingat tujuan Anda muncul. Teks tidak meninggalkan ponsel."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen bevakar adressfältet i webbläsarna på den här enheten. Öppnas ett blockerat mål stängs sessionen och din påminnelse visas. Texten lämnar inte telefonen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen bewaakt de adresbalk van browsers op dit apparaat. Opent een geblokkeerde bestemming, dan sluit de sessie en verschijnt je herinnering. Tekst verlaat de telefoon niet."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انٹروین اس فون کے براؤزرز کی ایڈریس بار دیکھتا ہے۔ بند منزل کھلتے ہی سیشن بند ہو جاتا ہے اور آپ کا ہدف سامنے آتا ہے۔ متن فون سے باہر نہیں جاتا۔"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen obserwuje pasek adresu przeglądarek na tym urządzeniu. Gdy otworzy się zablokowany adres, sesja się zamyka i pojawia się przypomnienie celu. Tekst nie opuszcza telefonu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Interveen observa a barra de endereços dos navegadores neste aparelho. Se um destino bloqueado abrir, a sessão fecha e seu lembrete aparece. O texto não sai do telefone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Interveen observa a barra de endereços dos navegadores neste aparelho. Se um destino bloqueado abrir, a sessão fecha e seu lembrete aparece. O texto não sai do telefone."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen osserva la barra degli indirizzi dei browser su questo dispositivo. Se si apre una destinazione bloccata, la sessione si chiude e compare il promemoria. Il testo non lascia il telefono."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen следит за адресной строкой браузеров на этом устройстве. Если открывается заблокированный адрес, сессия закрывается и появляется напоминание о цели. Текст не покидает телефон."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen bevakar adressfältet i webbläsarna på den här enheten. Öppnas ett blockerat mål stängs sessionen och din påminnelse visas. Texten lämnar inte telefonen."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen watches the address bar of your browsers on this device. When a blocked destination is opened, the browsing session is closed and your personal goal reminder is shown. Text never leaves the phone."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन इस फ़ोन के ब्राउज़र की एड्रेस बार देखता है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और आपका लक्ष्य सामने आता है। टेक्स्ट फ़ोन से बाहर नहीं जाता।"
