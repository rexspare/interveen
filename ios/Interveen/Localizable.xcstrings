    "onboarding_welcome_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنترفين وقفة هادئة بين الاندفاع والفعل. عندما تُفتح وجهة محظورة تُغلق الجلسة ويتقدم هدفك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन आवेग और कर्म के बीच एक शांत विराम है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और लक्ष्य आगे आता है।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen to cicha przerwa między impulsem a działaniem. Gdy otworzy się zablokowany adres, sesja się zamyka i cel wychodzi na pierwszy plan."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen är en tyst paus mellan impuls och handling. Öppnas ett blockerat mål stängs sessionen och målet träder fram."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen ist eine ruhige Pause zwischen Impuls und Handlung. Öffnet sich ein gesperrtes Ziel, schließt sich die Sitzung und Ihr Ziel tritt vor."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen is a quiet pause between impulse and action. When a blocked destination opens, the session closes and your goal comes forward."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen is a quiet pause between impulse and action. When a blocked destination opens, the session closes and your goal comes forward."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen es una pausa quieta entre el impulso y la acción. Si se abre un destino bloqueado, se cierra la sesión y tu meta pasa al frente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنترفين وقفة هادئة بين الاندفاع والفعل. عندما تُفتح وجهة محظورة تُغلق الجلسة ويتقدم هدفك."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen är en tyst paus mellan impuls och handling. Öppnas ett blockerat mål stängs sessionen och målet träder fram."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen adalah jeda tenang antara dorongan dan tindakan. Jika tujuan yang diblokir terbuka, sesi tertutup dan tujuan Anda tampil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen est une pause calme entre l’impulsion et l’acte. Si une destination bloquée s’ouvre, la session se ferme et votre objectif avance."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन आवेग और कर्म के बीच एक शांत विराम है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और लक्ष्य आगे आता है।"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen הוא הפסקה שקטה בין דחף לפעולה. כשנפתח יעד חסום, הסשן נסגר והמטרה יוצאת קדימה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन आवेग और कर्म के बीच एक शांत विराम है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और लक्ष्य आगे आता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen to cicha przerwa między impulsem a działaniem. Gdy otworzy się zablokowany adres, sesja się zamyka i cel wychodzi na pierwszy plan."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen adalah jeda tenang antara dorongan dan tindakan. Jika tujuan yang diblokir terbuka, sesi tertutup dan tujuan Anda tampil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen è una pausa quieta tra impulso e azione. Se si apre una destinazione bloccata, la sessione si chiude e il tuo obiettivo avanza."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen は衝動と行動のあいだの静かな間です。ブロックした行き先が開くとセッションが閉じ、目標が前に出ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen은 충동과 행동 사이의 고요한 멈춤입니다. 차단된 곳이 열리면 세션이 닫히고 목표가 앞으로 나옵니다."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इंटरवीन आवेग और कर्म के बीच एक शांत विराम है। अवरुद्ध गंतव्य खुलते ही सत्र बंद होता है और लक्ष्य आगे आता है।"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen adalah jeda tenang antara dorongan dan tindakan. Jika tujuan yang diblokir terbuka, sesi tertutup dan tujuan Anda tampil."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen är en tyst paus mellan impuls och handling. Öppnas ett blockerat mål stängs sessionen och målet träder fram."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interveen is een stille pauze tussen impuls en actie. Opent een geblokkeerde bestemming, dan sluit de sessie en komt je doel naar voren."
          }
        },
        "pa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انٹروین جذبے اور عمل کے درمیان ایک خاموش وقفہ ہے۔ بند منزل کھلتے ہی سیشن بند ہوتا ہے اور ہدف سامنے آتا ہے۔"
          }
        },
        "pl" : {
