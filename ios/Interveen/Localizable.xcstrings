    "media_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى الوسائط على هذا الجهاز. ينسخها إنترفين إلى تخزين خاص بالتطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मीडिया इसी फ़ोन पर रहता है। इंटरवीन उसे निजी संग्रह में कॉपी करता है।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Multimedia zostają na tym urządzeniu. Interveen kopiuje je do prywatnego magazynu."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mediet stannar på enheten. Interveen kopierar till privat lagring."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Medien bleiben auf diesem Gerät. Interveen kopiert sie in den privaten App-Speicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media stays on this device. Interveen copies it into private app storage."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Media stays on this device. Interveen copies it into private app storage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El contenido se queda en este dispositivo. Interveen lo copia a su almacenamiento privado."
