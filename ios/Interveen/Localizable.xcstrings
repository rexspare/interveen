    "onboarding_how_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time covers Apple’s adult catalog in Safari and Chrome. Safari still needs Interveen Blocker turned on. The Google app cannot be paused."
          }
        }
      }
    },
    "onboarding_permissions_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time is not Safari blocking. After Allow, open Safari Extensions and turn on Interveen Blocker. Notifications open your goal from a Screen Time shield."
          }
        }
      }
    },
    "onboarding_safari_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Blocker"
          }
        }
      }
    },
    "onboarding_safari_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Safari Extensions. Turn on Interveen Blocker. Screen Time Allow is a different switch and does not do this."
          }
        }
      }
    },
    "safari_help_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari still loads adult sites?"
          }
        }
      }
    },
    "safari_help_scope": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time permission does not turn on Safari blocking. Enable Interveen Blocker. Interveen Guard is optional for an in-page overlay."
          }
        }
      }
    },
    "safari_help_step_1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings → Apps → Safari → Extensions"
          }
        }
      }
    },
    "safari_help_step_2": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Interveen Blocker — this is the switch that stops wow.xxx in Safari"
          }
        }
      }
    },
    "safari_help_step_3": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional overlay: turn on Interveen Guard and set Other Websites to Allow"
          }
        }
      }
    },
    "safari_help_step_5": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Google app cannot be paused. Chrome only follows Apple’s adult catalog. Test wow.xxx in Safari after Interveen Blocker is on."
          }
        }
      }
    },
    "safari_help_step_4": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Safari open wow.xxx. The page should refuse to load. Not Chrome, not the Google app, not Private Browsing."
          }
        }
      }
    },
    "onboarding_notification_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a quiet Guard status so you can see that it is still watching."
          }
        }
      }
    },
    "dashboard_needs_safari": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Interveen Guard in Safari and allow it on all websites. This works in Safari only."
          }
        }
      }
    },
    "dashboard_status_active_body_ios": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Blocker is on. Screen Time still covers Apple’s adult catalog in Chrome."
          }
        }
      }
    },
    "onboarding_family_title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time Guard"
          }
        }
      }
    },
    "onboarding_family_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple’s adult catalog in Safari and Chrome. It does not turn on Interveen Blocker, and it cannot pause the Google app."
          }
        }
      }
    },
    "dashboard_needs_family": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Screen Time Guard, then Interveen Blocker in Safari Extensions. Screen Time Allow alone will not stop wow.xxx."
          }
        }
      }
    },
    "dashboard_status_family_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Time is on. Safari still needs Interveen Blocker in Settings → Safari → Extensions or wow.xxx will load."
          }
        }
      }
    },
    "dashboard_status_hybrid_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safari Blocker is on. Screen Time covers Chrome’s adult catalog. The Google app cannot be paused."
          }
        }
      }
    },
    "dashboard_preview_overlay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview reminder"
          }
        }
      }
    },
