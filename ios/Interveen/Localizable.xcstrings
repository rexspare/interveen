      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Google app cannot be paused. Use Safari. After Interveen Blocker is on, open wow.xxx there."
          }
        }
      }
    },
