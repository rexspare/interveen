    "media_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فيديو قصير هو الأفضل. صورة أو جملة تكفي إن كنت ستنظر إليها فعلاً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छोटा वीडियो बेहतर है। चित्र या वाक्य काफी है यदि आप उसे देखेंगे।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krótki film działa najlepiej. Zdjęcie lub zdanie wystarczy, jeśli naprawdę na nie spojrzysz."
          }
