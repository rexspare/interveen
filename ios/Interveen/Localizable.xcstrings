    "onboarding_accessibility_body" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة نص شريط العنوان في كروم وفايرفوكس وبريف وإيدج وجوجل. لا يُرفع شيء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्रोम, फ़ायरफ़ॉक्स, ब्रेव, एज और गूगल की एड्रेस बार। कुछ अपलोड नहीं होता।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czyta pasek w Chrome, Firefox, Brave, Edge i Google. Nic nie jest wysyłane."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser adressfältet i Chrome, Firefox, Brave, Edge och Google. Inget laddas upp."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liest die Adressleiste in Chrome, Firefox, Brave, Edge und Google. Nichts wird hochgeladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read address-bar text in Chrome, Firefox, Brave, Edge, and Google. Nothing is uploaded."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read address-bar text in Chrome, Firefox, Brave, Edge, and Google. Nothing is uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lee la barra de direcciones en Chrome, Firefox, Brave, Edge y Google. Nada se sube."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قراءة نص شريط العنوان في كروم وفايرفوكس وبريف وإيدج وجوجل. لا يُرفع شيء."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läser adressfältet i Chrome, Firefox, Brave, Edge och Google. Inget laddas upp."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membaca bilah alamat di Chrome, Firefox, Brave, Edge, dan Google. Tidak ada yang diunggah."
          }
