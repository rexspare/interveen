    <string name="app_name">Interveen</string>
    <string name="accessibility_service_label">Страж Interveen</string>
    <string name="accessibility_service_description">Interveen следит за адресной строкой браузеров на этом устройстве. Если открывается заблокированный адрес, сессия закрывается и появляется напоминание о цели. Текст не покидает телефон.</string>
